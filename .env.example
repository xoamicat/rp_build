# Copy to .env. Never commit .env.

# Razorpay TEST MODE keys (Dashboard -> Test Mode -> Settings -> API Keys). Leave blank for stub mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# LLM backend: mock | ollama | gemini
SAKSHI_LLM=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_RPM=10
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Ledger file
SAKSHI_DB=data/sakshi.db
