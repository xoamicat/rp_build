# Copy to .env. Never commit .env.

# Razorpay TEST MODE keys (Dashboard -> Test Mode -> Settings -> API Keys). Leave blank for stub mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Dashboard -> Webhooks. Required for production event ingestion.
RAZORPAY_WEBHOOK_SECRET=

# Ed25519 signing material for evidence seals. Keep the private key in a secret manager.
# Generate it outside the app; it must be a base64url-encoded 32-byte Ed25519 private key.
SAKSHI_EVIDENCE_PRIVATE_KEY_B64=
SAKSHI_EVIDENCE_KEY_ID=sakshi-prod-2026-01

# LLM backend: mock | ollama | gemini
SAKSHI_LLM=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_RPM=10
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Ledger file
SAKSHI_DB=data/sakshi.db
# Atlas's signed Offer Locks and Test Mode handoff state. Used only with a configured evidence key.
ATLAS_EVIDENCE_DB=data/atlas_evidence.db
